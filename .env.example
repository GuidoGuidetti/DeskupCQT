# Database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# SMTP Configuration (per invio email)
# Servizi SMTP gratuiti consigliati:
# - Brevo (ex Sendinblue): https://www.brevo.com/ - 300 email/giorno gratis
# - Resend: https://resend.com/ - 100 email/giorno gratis
# - Gmail SMTP: smtp.gmail.com (richiede app password)

# Esempio configurazione Brevo:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-email@example.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=noreply@yourdomain.com

# Email del partner (destinatario notifiche nuovi ticket)
PARTNER_EMAIL=partner@example.com
